# 复制为 deploy/.env 后按实际环境填写，切勿提交到仓库
MYSQL_ROOT_PASSWORD=change-me-strong-password

MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
# 浏览器/APP 可访问的 MinIO 地址，需与数据库中媒体 URL 前缀一致
MINIO_PUBLIC_URL=https://minio.example.com
MINIO_BUCKET=minthive

# 至少 32 字节随机字符串
JWT_SECRET=please-change-to-a-32-byte-random-secret

# cloud | local
AI_MODE=cloud
# base-url 填到版本段为止（如 /v1、/v4），客户端会追加 /chat/completions
AI_CLOUD_BASE_URL=https://api.openai.com/v1
AI_CLOUD_API_KEY=
AI_CLOUD_MODEL=gpt-4o-mini
AI_LOCAL_BASE_URL=http://ollama:11434
AI_LOCAL_MODEL=qwen3:7b

# 生产必须为 http，并配置短信网关
SMS_PROVIDER=http
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
